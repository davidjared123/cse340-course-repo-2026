<%- include('partials/header') %>
    <main class="home-page">
        <section class="hero-banner">
            <div class="hero-content">
                <h2>Welcome to the CSE 340 Service Network!</h2>
                <p>Our mission is to promote service across the world by connecting volunteers with service
                    opportunities in their community.</p>
                <a href="/projects" class="btn-primary">¡Inscribirme!</a>
            </div>
        </section>

        <section class="stats-section">
            <div class="stat-item">
                <h3>600 000+</h3>
                <p>Voluntarios</p>
            </div>
            <div class="stat-item">
                <h3>100 000+</h3>
                <p>Proyectos publicados</p>
            </div>
            <div class="stat-item">
                <h3>12 000+</h3>
                <p>Organizaciones asociadas</p>
            </div>
        </section>

        <section class="info-section">
            <img class="main-logo" src="/images/cse340-service-network.png" alt="CSE 340 Service Network Logo">
            <div class="info-text">
                <h2>Conectamos a voluntarios con las organizaciones que los necesitan</h2>
                <p>Nos encargamos de buscar organizaciones, encontrar proyectos de servicio, coordinar horarios y poner
                    a tu alcance proyectos de servicio locales. Todo lo que tienes que hacer es inscribirte.</p>
            </div>
        </section>
    </main>
    <%- include('partials/footer') %>