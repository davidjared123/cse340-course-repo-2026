<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
        <ul>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>"><%= category.name %></a>
                </li>
            <% }); %>
        </ul>
        <% if (typeof user !== 'undefined' && user && user.role_name === 'admin') { %>
            <p><a href="/new-category" class="action-btn">Add a New Category</a></p>
        <% } %>
    </main>
<%- include('partials/footer') %>
