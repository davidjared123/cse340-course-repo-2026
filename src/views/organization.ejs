<%- include('partials/header') %>
    <main>
        <h2><%= organizationDetails.name %></h2>
        <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">
        <p><%= organizationDetails.description %></p>
        <p><strong>Contact:</strong> <a href="mailto:<%= organizationDetails.contact_email %>"><%= organizationDetails.contact_email %></a></p>

        <h3>Associated Service Projects</h3>
        <% if (projects && projects.length > 0) { %>
            <ul>
                <% projects.forEach(project => { %>
                    <li>
                        <a href="/project/<%= project.project_id %>"><%= project.title %></a> - 
                        <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }) %>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>No service projects currently listed for this organization.</p>
        <% } %>
    </main>
<%- include('partials/footer') %>
