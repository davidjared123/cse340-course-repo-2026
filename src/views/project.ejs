<%- include('partials/header') %>
    <main>
        <h1><%= project.title %></h1>
        <p><%= project.description %></p>
        <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
        <p><strong>Partner Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
    </main>
<%- include('partials/footer') %>
