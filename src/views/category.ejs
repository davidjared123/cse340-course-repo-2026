<%- include('partials/header') %>
    <main>
        <h1><%= category.name %></h1>
        <h2>Service Projects in this Category</h2>
        <% if (projects && projects.length > 0) { %>
            <ul>
                <% projects.forEach(project => { %>
                    <li>
                        <a href="/project/<%= project.project_id %>"><%= project.title %></a> - 
                        <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }) %> 
                        (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>No service projects found in this category.</p>
        <% } %>
    </main>
<%- include('partials/footer') %>

